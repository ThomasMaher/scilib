<div>
  <div class="papers">
    <h2>Papers</h2>
      <div>Adding paper</div>
      <%= link_to 'Add a paper', new_paper_path, data: {turbo_frame: 'new_paper'} %>

    <%= turbo_frame_tag 'new_paper' %>
    <%= turbo_frame_tag 'papers' do %>
      <% @papers.each do |paper| %>
        <%= turbo_frame_tag paper do %>
          <%= render 'papers/paper', paper: paper %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <br>
  <br>
  <%= link_to 'Projects', projects_path, data: {turbo: false} %>
  <%= link_to 'Home', root_path, data: {turbo: false} %>
</div>