<div class="page-header">
  <h1>Papers</h1>
</div>

<%= turbo_stream_from 'papers' %>
<div class="list">
  <%= turbo_frame_tag 'papers' do %>
    <% @papers.each do |paper| %>
      <%= turbo_frame_tag paper do %>
        <%= render 'papers/paper', paper: paper %>
      <% end %>
    <% end %>
  <% end %>
</div>
