  <%= turbo_stream_from 'notes' %>

  <div>
    <div class="paper">
      <div style="text-align:center">
        <h1><%= @paper.title %></h1>
        <h5><%= @paper.publisher %>: <%= @paper.year_published %></h5>
        <p><%= @paper.content %></p>
        <div class="paper_display" data-controller="paper">
          <div>

          </div>
          <div class="paper_container">
            <div>
              <% paper_pages(@paper.title).each do |i| %>
                <div style="display:flex;">
                  <%= image_tag @paper.title + '/' + i.split('/')[-1], height: '800' %>
                  <div class="note_bar-right">
                    <% 80.times do |i| %>
                      <%= button_to "",
                                    new_project_paper_note_path(@project_paper, Note.new),
                                    class: 'note_tab',
                                    id: "note#{i}",
                                    data: {action: "click->paper#addNote"}
                      %>
<!--                      <div class="note_tab" id=<%#= "note#{i}" %> data-action="click->paper#addNote"></div>-->
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
          <div>
          </div>
        </div>
      </div>
      <%= turbo_frame_tag 'new_note' do %>
        <% if nested_to_project? %>
          <%= link_to 'Add a note', new_project_paper_note_path(@project_paper), data: {turbo_frame: 'new_note'} %>
        <% end %>
      <% end %>
      </div>

    <%= render 'notes/list', notes: @notes %>

    <%= link_to 'Project papers', papers_path, data: {turbo: false} %>
    <%= link_to 'Home', root_path, data: {turbo: false} %>
  </div>