<div>
  <%= turbo_frame_tag 'second_frame' do %>
    <div class="paper">
      <h1><%= @paper.title %></h1>
      <h5><%= @paper.year_published %>: <%= @paper.publisher %></h5>
      <p><%= @paper.content %></p>
    </div>

    <%= link_to 'Project papers', papers_path, data: {turbo: false} %>
    <%= link_to 'Home', root_path, data: {turbo: false} %>
  <% end %>
</div>