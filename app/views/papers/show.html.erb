<%= turbo_stream_from 'notes' %>

<div class="paper-detail card">
  <h1><%= @paper.title %></h1>
  <h5><%= @paper.publisher %>: <%= @paper.year_published %></h5>
  <% if @paper.content.present? %>
    <p><%= @paper.content %></p>
  <% end %>
  <% paper_pages(@paper.title).each do |i| %>
    <%= image_tag @paper.title + '/' + i.split('/')[-1] %>
  <% end %>
</div>

<div class="page-actions">
  <%= turbo_frame_tag 'new_note' do %>
    <% if nested_to_project? %>
      <%= link_to 'Add a note', new_project_paper_note_path(@project_paper), class: "btn-primary", data: { turbo_frame: 'new_note' } %>
    <% end %>
  <% end %>
</div>

<div class="notes-section">
  <h3>Notes</h3>
  <%= render 'notes/list', notes: @notes %>
</div>

<div class="footer-nav">
  <%= link_to 'All papers', papers_path %>
  <% if nested_to_project? %>
    <%= link_to 'Back to project', project_path(@project) %>
  <% end %>
</div>
