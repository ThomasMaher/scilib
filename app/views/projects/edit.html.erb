<%= turbo_frame_tag @project do %>
  <div class="form-card">
    <%= form_for @project, url: project_path(@project.id), method: :patch do |f| %>
      <div class="form-group">
        <%= f.label :title, 'Project title' %>
        <%= f.text_field :title, class: "form-control", value: @project.title %>
      </div>
      <div class="form-actions">
        <%= f.submit "Update", class: "btn-primary" %>
        <%= link_to 'Cancel', projects_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
<% end %>
