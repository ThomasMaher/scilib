<%= turbo_stream_from 'papers' %>

<%= turbo_frame_tag 'unlisted_papers' do %>
  <div class="papers_modal" data-controller="papers">
    <h2 class="modal-header">Papers</h2>
    <p data-papers-target="message"></p>
    <% @papers.each do |paper| %>
      <div class="papers_modal-item">
        <input data-papers-target="paper"
          type="checkbox"
          id=<%= "paper#{paper.id}" %>
          value=<%= paper.id %>
          name=<%= "paper#{paper.id}" %>>
        <label style="font-size:24px" class="papers_modal-label" for=<%= "paper#{paper.id}" %>><%= paper.title %></label><br>
        <div>
          <p style="margin:2px 0 0 33px;font-size:14px"><%= paper.year_published %>. <%= paper.publisher%></p>
        </div>
      </div>
    <% end %>
    <button
      data-action="papers#submit"
      data-papers-target="route"
      data-turbo-frame="unlisted_papers"
      value=<%= project_add_papers_path(@project) %>
    >
      Submit
    </button>
  </div>
<% end %>