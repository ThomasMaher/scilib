<div class="form-card">
  <%= form_for @project, url: projects_path, method: :post do |f| %>
    <div class="form-group">
      <%= f.label :title, 'Project title' %>
      <%= f.text_field :title, class: "form-control" %>
    </div>
    <div class="form-actions">
      <%= f.submit "Create", class: "btn-primary", data: { turbo_frame: '_top' } %>
      <%= link_to 'Cancel', projects_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
