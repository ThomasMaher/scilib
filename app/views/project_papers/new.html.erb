<%= turbo_frame_tag "new_project_paper" do %>
  <div class="form-card">
    <%= form_for @paper, method: :post do |f| %>
      <div class="form-group">
        <%= f.label :title, 'Title' %>
        <%= f.text_field :title, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :year_published, 'Year Published' %>
        <%= f.text_field :year_published, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :publisher, 'Publisher' %>
        <%= f.text_field :publisher, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :content, 'Description' %>
        <%= f.text_area :content, class: "form-control" %>
      </div>
      <div class="form-actions">
        <%= f.submit "Create", class: "btn-primary" %>
        <%= link_to 'Cancel', project_path(@project), class: "btn-secondary" %>
      </div>
      <%= hidden_field_tag name: :project_id, value: @project.presence&.id %>
    <% end %>
  </div>
<% end %>
