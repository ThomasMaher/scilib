<%= turbo_frame_tag "new_project_paper" do %>
  <%= form_for @paper, method: :post do |f| %>
    <div>
      <%= f.label :title, 'Title: ' %>
      <%= f.text_field :title %>
    </div>
    <div>
      <%= f.label :year_published, 'Year Published: ' %>
      <%= f.text_field :year_published %>
    </div>
    <div>
      <%= f.label :publisher, 'Publisher: ' %>
      <%= f.text_field :publisher %>
    </div>
    <div>
      <%= f.label :content, 'Description: ' %>
      <%= f.text_area :content %>
    </div>
    <div>
      <%= f.submit "Create" %>
    </div>
    <%= hidden_field_tag name: :project_id, value: @project.presence&.id %>
  <% end %>

  <%= link_to 'Back', project_path(@project) %>
<% end %>
